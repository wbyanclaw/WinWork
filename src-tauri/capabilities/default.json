{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-open",
    "window:allow-minimize",
    "window:allow-maximize",
    "window:allow-unmaximize",
    "window:allow-close",
    "window:allow-is-maximized",
    "window:allow-toggle-maximize",
    "window:allow-set-focus",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "run-powershell-install",
          "cmd": "powershell",
          "args": ["-ExecutionPolicy", "Bypass", "-Command", { "validator": "\\S+" }]
        },
        {
          "name": "run-bash-install",
          "cmd": "bash",
          "args": ["-c", { "validator": "\\S+" }]
        },
        {
          "name": "run-sh-install",
          "cmd": "sh",
          "args": ["-c", { "validator": "\\S+" }]
        }
      ]
    }
  ]
}
